# Copie este arquivo para .env e ajuste. Nenhuma senha de exemplo fica no código.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=anexsys
DB_SCHEMA=public

# Homologação (Neon): use a connection string DIRETA, sem "-pooler" no host.
# DATABASE_URL=postgresql://USER:SENHA@HOST/DB?sslmode=require
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=
PORT=3000

# Obrigatórias para criar o primeiro administrador (scripts de bootstrap).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador Local

# Opcionais do bootstrap
BOOTSTRAP_TENANT_CODE=ANXDEV
BOOTSTRAP_TENANT_LEGAL_NAME=ANEXSYS DEV LTDA
BOOTSTRAP_TENANT_DISPLAY_NAME=ANEXSYS DEV
BOOTSTRAP_BRANCH_CODE=HQ
BOOTSTRAP_BRANCH_LEGAL_NAME=ANEXSYS DEV MATRIZ
BOOTSTRAP_BRANCH_DISPLAY_NAME=Matriz
BOOTSTRAP_BRANCH_CALENDAR_NAME=Calendario Local

# Homologação no Render: o start-web.cjs aplica migração e, se true, o bootstrap.
# BOOTSTRAP_ON_START=true
